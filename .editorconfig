root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Existing backend code mixes tabs and spaces: keep whatever each file already uses
[backend/src/**]
indent_style = unset
indent_size = unset
